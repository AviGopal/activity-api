{
  "name": "metabob-activity-api",
  "version": "1.2.5",
  "description": "Lightweight TypeScript server for Metabob activity system - replaces Python RPC API v2 endpoints",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "init-db": "bun run scripts/init-database.ts",
    "init-data": "bun run sql/init-test-data.ts",
    "seed-templates": "bun run sql/seed-templates.ts",
    "extract-variants": "bun run sql/extract-best-variants.ts",
    "test": "bun test",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@stdlib/random-base-beta": "^0.2.1",
    "argon2": "^0.41.1",
    "hono": "^4.0.0",
    "ioredis": "^5.3.2",
    "jose": "^6.2.2",
    "nanoid": "^5.0.4",
    "surrealdb": "^2.0.3",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
